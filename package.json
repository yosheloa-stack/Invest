{
  "name": "yosh-crypto-scanner",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx --watch src/server.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "start": "node square-start.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "export": "node --import tsx scripts/export.ts",
    "replay": "node --import tsx scripts/replay.ts",
    "typecheck:web": "tsc -p tsconfig.web.json",
    "format": "prettier --write src web scripts tests",
    "format:check": "prettier --check src web scripts tests",
    "start:local": "node --env-file=.env dist/server.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "restore": "node --env-file-if-exists=.env scripts/restore.mjs",
    "lab": "node --import tsx scripts/lab.ts"
  },
  "dependencies": {
    "express": "5.1.0",
    "https-proxy-agent": "^7.0.6",
    "pino": "9.9.0",
    "undici": "6.29.0",
    "ws": "8.22.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@types/three": "^0.186.0",
    "@types/ws": "8.18.1",
    "cryptocurrency-icons": "^0.18.1",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "0.468.0",
    "prettier": "3.6.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "technicalindicators": "^3.1.0",
    "three": "^0.186.1",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "6.3.6"
  },
  "engines": {
    "node": ">=22.16 <27"
  }
}
