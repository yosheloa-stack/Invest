PORT=8080
SQLITE_PATH=./data/scanner.sqlite
DASHBOARD_USER=
DASHBOARD_PASSWORD=
PUBLIC_ORIGIN=
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
BINANCE_REST=https://data-api.binance.vision
BINANCE_WS=wss://data-stream.binance.vision/stream
STALE_MS=5000
MAX_CLOCK_UNCERTAINTY_MS=1000
MODE=PAPER
SNIPER=false
PAYOUT=0.8
RETURN_THRESHOLD=0.0005
MIN_PROBABILITY=0.60
MIN_GROUPS=4
COOLDOWN_MS=300000
MODEL_DIR=./models
MODEL_MAX_AGE_DAYS=14
# JSON feed contract documented in docs/API.md; no provider is silently invented.
NEWS_URL=
NEWS_API_KEY=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=
NEWS_REQUIRED=false
# Optional JSON object overriding group weights; values >=0. Not probabilities.
GROUP_WEIGHTS={"trend":1,"momentum":1,"structure":1,"volume":1,"flow":1,"mtf":1,"news":1,"reaction":1}
LOG_LEVEL=info
