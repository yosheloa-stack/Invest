PORT=8080
SQLITE_PATH=./data/scanner.sqlite
DASHBOARD_USER=
DASHBOARD_PASSWORD=
PUBLIC_ORIGIN=
# SYMBOLS: deixe sem definir para usar a lista completa (igual à Ebinex)
BINANCE_REST=https://data-api.binance.vision
BINANCE_WS=wss://data-stream.binance.vision/stream
STALE_MS=5000
MAX_CLOCK_UNCERTAINTY_MS=1000
MODE=PAPER
SNIPER=false
PAYOUT=0.9
RETURN_THRESHOLD=0.0005
MIN_PROBABILITY=0.60
MIN_GROUPS=4
COOLDOWN_MS=300000
MODEL_DIR=./models
MODEL_MAX_AGE_DAYS=14
# JSON feed contract documented in docs/API.md; no provider is silently invented.
NEWS_URL=
NEWS_API_KEY=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=
NEWS_REQUIRED=false
# Optional JSON object overriding group weights; values >=0. Not probabilities.
GROUP_WEIGHTS={"trend":1,"momentum":1,"structure":1,"volume":1,"flow":1,"mtf":1,"news":1,"reaction":1}
LOG_LEVEL=info
# --- Quotex Bot ---
QUOTEX_EMAIL=
QUOTEX_PASSWORD=
QUOTEX_SSID=
QUOTEX_HOST=qxbroker.com
QUOTEX_DEMO=true
QUOTEX_MIN_PAYOUT=0.80
QUOTEX_EXPIRATION=300
QUOTEX_START_BALANCE=60
QUOTEX_TARGET_BALANCE=600
QUOTEX_MAX_STAKE_PCT=0.05
QUOTEX_MIN_STAKE=1
QUOTEX_MIN_CONFLUENCE=3
QUOTEX_COOLDOWN_MS=300000
QUOTEX_MAX_CONSEC_LOSSES=3
QUOTEX_DAILY_LOSS_LIMIT=0.30
